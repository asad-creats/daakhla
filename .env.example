# Supabase project (Project Settings → API). Leave both empty to run in local
# demo mode: seeded data stored in this browser's localStorage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public base URL printed on registration links and QR codes.
# Defaults to the origin the app is served from.
VITE_PUBLIC_FORM_BASE=
